# Build context is load-test/ itself:
#   docker build -f load-test/Dockerfile.bots -t meet-loadtest-bots load-test
# Only signal-bots.ts's own dependency (socket.io-client) is needed here -
# the Chromium-based bots.ts/Playwright path isn't used from a container, so
# this deliberately doesn't reuse load-test/package.json (which pulls in the
# much heavier playwright/@clerk deps that image never needs).
FROM node:22-bookworm-slim
WORKDIR /app
RUN npm install --no-save socket.io-client tsx @types/node
COPY signal-bots.ts ./
ENTRYPOINT ["npx", "tsx", "signal-bots.ts"]
